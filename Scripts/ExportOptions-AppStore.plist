<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>method</key>
	<string>app-store-connect</string>
	<key>teamID</key>
	<string>D4DDD7PH6S</string>
	<key>signingStyle</key>
	<string>automatic</string>
	<!-- Uploads straight to App Store Connect rather than writing a local .ipa,
	     so there is no separate altool/Transporter step. -->
	<key>destination</key>
	<string>upload</string>
	<key>uploadSymbols</key>
	<true/>
	<!-- Versions are passed explicitly on the xcodebuild command line; letting
	     Xcode manage them would silently diverge from the git-derived build
	     number the macOS pipeline uses. -->
	<key>manageAppVersionAndBuildNumber</key>
	<false/>
</dict>
</plist>
