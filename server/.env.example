# Password for /admin. Set this to something long and random before deploying.
ADMIN_PASSWORD=change-me

# Secret used to sign the admin session cookie.
SESSION_SECRET=generate-with-openssl-rand-hex-32

# Where the SQLite file lives.
# Local dev: ./data/selahbeat.db
# Installed on a server: an absolute path outside the deployed tree, so that
# redeploying never touches it, e.g. /var/lib/selahbeat/selahbeat.db
DATABASE_PATH=./data/selahbeat.db

# Port the Node process listens on, behind your existing nginx or Caddy.
# Deliberately not 3000, which is usually already taken on a shared host.
PORT=3411

# Repo used by the landing page to show the latest download.
GITHUB_REPO=0xt1m/selahbeat
