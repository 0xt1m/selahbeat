# Password for /admin. Set this to something long and random before deploying.
ADMIN_PASSWORD=change-me

# Secret used to sign the admin session cookie.
SESSION_SECRET=generate-with-openssl-rand-hex-32

# Where the SQLite file lives. On EC2 point this at a mounted EBS volume so
# the catalog survives container restarts.
DATABASE_PATH=./data/selahbeat.db

# Repo used by the landing page to show the latest download.
GITHUB_REPO=0xt1m/selahbeat
